# Copy to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (see README setup section)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fmc

# Optional: used by the frontend to call the API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: free key from https://data.gov.in, needed for the mandi price sync
DATA_GOV_API_KEY=

# Optional: LLM rescue for ingredient lines the regex parser can't handle.
# Without a key the importer still works — unparsed lines just stay flagged
# for manual entry. Set whichever one you have; groq wins if both are present.
#
# NOTE: put values on their own line with nothing after them. Comments must be
# on separate lines — the .env reader keeps everything after "=" as the value.
#
# GROQ_API_KEY: free at https://console.groq.com
GROQ_API_KEY=
# GEMINI_API_KEY: free at https://aistudio.google.com
GEMINI_API_KEY=

# Optional overrides. LLM_PROVIDER forces groq or gemini instead of
# auto-detecting; LLM_MODEL defaults to llama-3.3-70b-versatile (groq)
# or gemini-2.5-flash (gemini).
# LLM_PROVIDER=
# LLM_MODEL=
